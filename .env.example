# 仅为模拟 Python 契约的占位配置；真实 OpenClaw 配置位于用户目录，
# 不从此文件读取，也不得把微信 ID、二维码、令牌或 OAuth 数据写入仓库。
BRIDGE_DB_PATH=./var/bridge.db
BRIDGE_ALLOWED_RECIPIENTS=contact:authorized-user
OPENCLAW_WEBHOOK_SECRET=replace-me
OPENCLAW_SEND_ENDPOINT=https://openclaw-gateway.invalid/v1/send
CODEX_ENDPOINT=http://127.0.0.1:9999/placeholder
